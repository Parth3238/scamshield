# Files that must never go into the Docker image.
.venv/
__pycache__/
*.pyc
*.pyo
tests/
test_qr_images/
*.db
*.db.bak
*.db-journal
*.sqlite
*.sqlite3
.env
.env.*
.pytest_cache/
.mypy_cache/
.ruff_cache/
# scripts/ is intentionally NOT ignored: the image needs
# scripts/create_admin.py for "docker compose exec backend ...".
.git/
.gitignore
Dockerfile
.dockerignore
DOCKER.md
*.md
