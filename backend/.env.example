# Copy this file to .env and fill in real values. Never commit .env.
# SECRET_KEY must be a random string of at least 32 characters.
SECRET_KEY=replace-this-with-a-random-string-at-least-32-chars
# Login token lifetime in minutes.
ACCESS_TOKEN_MINUTES=60
# Set to true when serving over HTTPS so the login cookie is Secure.
COOKIE_SECURE=false
# development or production. Production disables /docs, /redoc, /openapi.json.
ENVIRONMENT=development
# Comma-separated origins allowed for CORS. Empty by default because the
# frontend uses the same-origin /api proxy (no cross-origin needed).
ALLOWED_ORIGINS=
