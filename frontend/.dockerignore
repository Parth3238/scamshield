# Files never needed to build or run the frontend image.
node_modules/
.next/
out/
build/
coverage/
.nyc_output/
.env*
!.env.example
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.DS_Store
*.pem
.vercel/
*.tsbuildinfo
next-env.d.ts
.git/
.gitignore
Dockerfile
.dockerignore
DOCKER.md
README.md
AGENTS.md
# Tests are not needed to build or run the image, and `next build`
# type-checks everything it sees — so test files must stay out of
# the build context entirely.
**/*.test.ts
**/*.test.tsx
vitest.config.mts
vitest.setup.ts
