# ScamShield compose environment. Copy to .env and fill in real values.
# NEVER commit .env (it is in .gitignore). No real secrets below.

# PostgreSQL login used by the postgres service and the backend.
POSTGRES_USER=scamshield
POSTGRES_PASSWORD=replace-this-with-a-long-random-password
POSTGRES_DB=scamshield

# Backend signing secret. At least 32 characters. Generate one with:
#   -join ((48..57+65..90+97..122) | Get-Random -Count 48 | ForEach-Object {[char]$_})
SECRET_KEY=replace-this-with-a-random-string-at-least-32-chars

# Redis password for rate limiting. Alphanumeric only (it goes inside
# REDIS_URL, where special characters would break parsing). Generate with:
#   -join ((48..57+65..90+97..122) | Get-Random -Count 32 | ForEach-Object {[char]$_})
REDIS_PASSWORD=replace-this-with-a-long-alphanumeric-password

# Separate database used ONLY for the test suite (never the app database).
# The suite uses it only when TEST_DATABASE_URL is set.
TEST_DATABASE_URL=postgresql+psycopg://scamshield:replace-this-with-a-long-random-password@localhost:5433/scamshield_test

# Cookie flag for HTTPS deployments. Keep false for local http://localhost
# testing. Set to true when serving behind HTTPS so the login cookie gets
# the Secure attribute (see docker-compose.yml backend environment).
COOKIE_SECURE=false
